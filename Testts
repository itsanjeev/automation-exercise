    # ── Download file assertions ────────────────────────────────────

    @keyword(name="Downloaded File Should Exist")
    def downloaded_file_should_exist(
        self,
        path: str,
        message: str | None = None,
    ) -> None:
        """Assert that a file exists at the given path.

        Examples:
        | ${path}= | Click And Download        | css=.dl-btn       |
        | Downloaded File Should Exist          | ${path}           |
        """
        if not Path(path).is_file():
            raise AssertionError(
                message or f"File does not exist: {path}"
            )
        size = Path(path).stat().st_size
        logger.info(f"PASS: File exists: {path} ({size} bytes)")

    @keyword(name="Downloaded File Should Not Be Empty")
    def downloaded_file_should_not_be_empty(
        self,
        path: str,
        message: str | None = None,
    ) -> None:
        """Assert that a downloaded file exists and is not empty (> 0 bytes).

        Examples:
        | ${path}= | Click And Download               | css=.dl-btn  |
        | Downloaded File Should Not Be Empty          | ${path}      |
        """
        p = Path(path)
        if not p.is_file():
            raise AssertionError(
                message or f"File does not exist: {path}"
            )
        size = p.stat().st_size
        if size == 0:
            raise AssertionError(
                message or f"File is empty (0 bytes): {path}"
            )
        logger.info(f"PASS: File is not empty: {path} ({size} bytes)")

    @keyword(name="Downloaded File Should Contain")
    def downloaded_file_should_contain(
        self,
        path: str,
        expected_text: str,
        encoding: str = "utf-8",
        message: str | None = None,
    ) -> None:
        """Assert that a downloaded text file contains the expected string.

        Works for CSV, JSON, XML, TXT, HTML, etc.

        Examples:
        | ${path}= | Click And Download              | css=.export      |
        | Downloaded File Should Contain | ${path}   | "total": 42      |
        | Downloaded File Should Contain | ${path}   | Name,Email,Phone |
        """
        p = Path(path)
        if not p.is_file():
            raise AssertionError(f"File does not exist: {path}")
        content = p.read_text(encoding=encoding)
        if expected_text not in content:
            preview = content[:500]
            raise AssertionError(
                message
                or f"File '{path}' does not contain '{expected_text}'.\n"
                   f"File preview (first 500 chars):\n{preview}"
            )
        logger.info(f"PASS: File contains '{expected_text}'")

    @keyword(name="Downloaded File Size Should Be")
    def downloaded_file_size_should_be(
        self,
        path: str,
        expected_size: int,
        operator: Literal["==", ">=", "<=", ">", "<"] = ">=",
        message: str | None = None,
    ) -> int:
        """Assert the size of a downloaded file in bytes.

        ``operator``  Comparison: == , >= (default), <= , > , <

        Returns the actual file size.

        Examples:
        | Downloaded File Size Should Be | ${path} | 1024         |
        | Downloaded File Size Should Be | ${path} | 0    | >     |
        """
        p = Path(path)
        if not p.is_file():
            raise AssertionError(f"File does not exist: {path}")
        actual = p.stat().st_size
        expected_size = int(expected_size)
        ops = {
            "==": lambda a, b: a == b,
            ">=": lambda a, b: a >= b,
            "<=": lambda a, b: a <= b,
            ">": lambda a, b: a > b,
            "<": lambda a, b: a < b,
        }
        cmp = ops.get(operator)
        if cmp is None:
            raise ValueError(f"Invalid operator '{operator}'")
        if not cmp(actual, expected_size):
            raise AssertionError(
                message
                or f"File size {actual} bytes is not {operator} {expected_size} bytes"
            )
        logger.info(f"PASS: File size {actual} {operator} {expected_size}")
        return actual
