    # ── Element count ───────────────────────────────────────────────

    @keyword(name="Element Count Should Be")
    def element_count_should_be(
        self,
        selector: str,
        expected: int,
        operator: Literal["==", ">=", "<=", ">", "<"] = "==",
        message: str | None = None,
    ) -> int:
        """Assert the number of elements matching a selector.

        ``operator``  Comparison: == (default), >=, <=, >, <

        Returns the actual count.

        Examples:
        | Element Count Should Be | css=.list-item | 5             |
        | Element Count Should Be | css=.error     | 0             |
        | Element Count Should Be | css=tr.row     | 3  | >=       |
        """
        resolved = _resolve_selector(selector)
        actual = self._active_page.locator(resolved).count()
        expected = int(expected)
        ops = {
            "==": lambda a, b: a == b,
            ">=": lambda a, b: a >= b,
            "<=": lambda a, b: a <= b,
            ">": lambda a, b: a > b,
            "<": lambda a, b: a < b,
        }
        cmp = ops.get(operator)
        if cmp is None:
            raise ValueError(f"Invalid operator '{operator}'. Use: ==, >=, <=, >, <")
        if not cmp(actual, expected):
            raise AssertionError(
                message
                or f"Element count for '{selector}': {actual} is not {operator} {expected}"
            )
        logger.info(f"PASS: '{selector}' count {actual} {operator} {expected}")
        return actual

