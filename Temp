## 9. Adapter ABC & Implementations

### `adapters/base.py`

```python
class Adapter(ABC):
    name: str                              # "claude" | "cursor" | ...

    @classmethod
    @abstractmethod
    def detect(cls) -> bool:
        """Return True if this adapter's runtime is installed on this machine."""

    @abstractmethod
    def install_asset(self, asset: Asset) -> Projection: ...

    @abstractmethod
    def uninstall_asset(self, projection: Projection) -> None: ...

    @abstractmethod
    def verify_asset(self, projection: Projection) -> bool:
        """Return True iff the asset is correctly projected on disk."""

    @abstractmethod
    def merge_hooks(self, hooks: list[HookEntry]) -> None: ...

    @abstractmethod
    def remove_hooks(self, asset_id: str) -> None: ...
```

### `adapters/claude.py`

```python
class ClaudeAdapter(Adapter):
    name = "claude"
    home = Path.home() / ".claude"

    @classmethod
    def detect(cls): return cls.home.exists()

    def install_asset(self, asset):
        if asset.kind == AssetKind.SKILL:
            target = self.home / "skills" / f"mfaw-{asset.id}"
            return stub.install(asset.path, target, kind=DIRECTORY)
        if asset.kind == AssetKind.COMMAND:
            target = self.home / "commands" / "mfaw" / f"{asset.id}.md"
            target.parent.mkdir(parents=True, exist_ok=True)
            return stub.install(asset.path, target, kind=FILE)
        if asset.kind == AssetKind.AGENT:
            target = self.home / "agents" / f"mfaw-{asset.id}.md"
            return stub.install(asset.path, target, kind=FILE)
        if asset.kind == AssetKind.RULE:
            target = self.home / "rules" / f"mfaw-{asset.id}.md"
            return stub.install(asset.path, target, kind=FILE)
        raise UnsupportedAssetKind(asset.kind)

    def merge_hooks(self, hooks):
        settings_path = self.home / "settings.json"
        with file_lock(settings_path):
            settings = json.loads(settings_path.read_text() or "{}")
            settings.setdefault("hooks", {})
            for h in hooks:
                settings["hooks"].setdefault(h.event, [])
                settings["hooks"][h.event].append({
                    "_mfaw_managed": f"asset:{h.asset_id}@{h.asset_version}",
                    "description": h.description,
                    "hooks": h.entries,
                })
            atomic_write(settings_path, json.dumps(settings, indent=2))

    def remove_hooks(self, asset_id):
        settings_path = self.home / "settings.json"
        with file_lock(settings_path):
            settings = json.loads(settings_path.read_text() or "{}")
            for event, entries in settings.get("hooks", {}).items():
                settings["hooks"][event] = [
                    e for e in entries
                    if not str(e.get("_mfaw_managed", "")).startswith(f"asset:{asset_id}@")
                ]
            atomic_write(settings_path, json.dumps(settings, indent=2))
```

### `adapters/cursor.py`

Same pattern, projects to `~/.cursor/rules/*.mdc`.

### Registry

```python
# adapters/__init__.py
ADAPTER_REGISTRY: dict[str, type[Adapter]] = {
    "claude": ClaudeAdapter,
    "cursor": CursorAdapter,
}

def detected_adapters() -> list[Adapter]:
    return [cls() for cls in ADAPTER_REGISTRY.values() if cls.detect()]
```

Adding a new adapter = one new file in `adapters/` + one line in the registry.

