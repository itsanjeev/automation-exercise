def install(src: Path, dst: Path, *, kind: AssetKind) -> Projection: ...
def uninstall(projection: Projection) -> None: ...
def is_mfaw_managed(target: Path, expected_hash: str | None = None) -> bool: ...

def _create_junction(src: Path, dst: Path) -> None:    # Windows only
    import _winapi; _winapi.CreateJunction(str(src), str(dst))

def _copy_with_sentinel(src: Path, dst: Path, asset_id: str, version: str) -> str:
    body = src.read_text()
    sha = hashlib.sha256(body.encode()).hexdigest()[:16]
    sentinel = f"<!-- mfaw:managed asset={asset_id} version={version} sha={sha} -->\n"
    dst.write_text(sentinel + body)
    return sha
