## 7. Sync Algorithm

```python
def sync(repo_root: Path | None = None, *, reinstall: bool = False) -> SyncReport:
    # 1. Detect project
    project = find_project_root(repo_root or Path.cwd())   # walks up looking for .mfaw/

    # 2. Load ledgers
    global_ledger = StateLedger.load_global()              # ~/.mfaw/state.json
    project_ledger = StateLedger.load_project(project) if project else None

    # 3. Load manifests
    global_manifest = load_global_manifest()               # content/manifest.json
    project_manifest = load_project_manifest(project) if project else None

    # 4. Validate
    validate_schema(global_manifest, "manifest.schema.json")
    if project_manifest:
        validate_schema(project_manifest, "project-manifest.schema.json")

    # 5. Resolve effective set
    effective = resolve(global_manifest, project_manifest, available_adapters())

    # 6. Diff
    current = active_ledger_or_empty(reinstall)
    plan = build_plan(current, effective)
    # plan = [Action(kind: INSTALL|UPDATE|REMOVE|KEEP, asset, adapter)]

    # 7. Acquire lock
    with FileLock("~/.mfaw/state.json.lock"):

        # 8. Apply plan
        report = SyncReport()
        for action in plan:
            try:
                if action.kind == INSTALL:
                    proj = install_asset(action.asset, action.adapter)
                    global_ledger.record(proj) if proj.layer == GLOBAL else project_ledger.record(proj)
                elif action.kind == UPDATE:
                    uninstall_asset(action.previous)
                    proj = install_asset(action.asset, action.adapter)
                    ...
                elif action.kind == REMOVE:
                    uninstall_asset(action.previous)
                    ledger.forget(action.previous)
                report.add(action, status=OK)
            except Exception as e:
                report.add(action, status=FAIL, error=e)
                # Continue — partial sync is better than nothing.

        # 9. Persist ledgers (atomic)
        global_ledger.save_atomic()
        if project_ledger: project_ledger.save_atomic()

        # 10. Update active_project
        if project:
            update_active_project(project)

    return report
```

**Invariants:**
- Sync is idempotent: run twice → second run is all `KEEP`.
- Sync is partial-failure-safe: one bad asset doesn't abort the rest.
- Sync is concurrent-safe: lock prevents two sync runs colliding.

