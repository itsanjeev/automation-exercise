### `src/mfaw/cli.py`

```python
import argparse, sys
from . import __version__
from .commands import init, sync, pull, publish, nuke, doctor, status, list_, use
from .errors import MfawError
from .logging import configure as configure_logging

COMMANDS = {
    "init": init, "sync": sync, "pull": pull, "publish": publish,
    "nuke": nuke, "doctor": doctor, "status": status, "list": list_, "use": use,
}

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="mfaw")
    p.add_argument("--version", action="version", version=f"mfaw {__version__}")
    p.add_argument("--verbose", "-v", action="store_true")
    p.add_argument("--quiet", "-q", action="store_true")
    p.add_argument("--no-color", action="store_true")
    p.add_argument("--config", type=str, default=None)

    sub = p.add_subparsers(dest="command", required=True)
    for name, mod in COMMANDS.items():
        mod.add_parser(sub)
    return p

def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    configure_logging(verbose=args.verbose, quiet=args.quiet, color=not args.no_color)
    try:
        return COMMANDS[args.command].run(args) or 0
    except MfawError as e:
        print(f"error: {e}", file=sys.stderr)
        return e.exit_code
    except KeyboardInterrupt:
        return 130
