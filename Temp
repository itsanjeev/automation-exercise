import argparse
from pathlib import Path
from ..manifest import load_global_manifest, load_project_manifest, resolve
from ..state import StateLedger, file_lock
from ..adapters import detected_adapters
from ..logging import log

def add_parser(sub):
    p = sub.add_parser("sync", help="Re-project effective set into adapters")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--reinstall", action="store_true")
    return p

def run(args) -> int:
    project = find_project_root(Path.cwd())
    global_manifest = load_global_manifest()
    project_manifest = load_project_manifest(project) if project else None
    adapters = [a.name for a in detected_adapters()]

    effective = resolve(global_manifest, project_manifest, adapters)

    global_ledger = StateLedger.load_global()
    project_ledger = StateLedger.load_project(project) if project else None

    with file_lock(global_ledger.path):
        plan = build_plan(global_ledger, project_ledger, effective, args.reinstall)
        report = apply_plan(plan, global_ledger, project_ledger)
        global_ledger.save_atomic()
        if project_ledger: project_ledger.save_atomic()

    if not args.quiet: report.print()
    return 0 if report.ok else 1
